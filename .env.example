# GEAR environment variables.
# Copy this file to .env (gitignored) and fill in real values:
#   cp .env.example .env
# Never commit .env. See "Security & environment variables" in README.md.

# --- Postgres ---
# The password below is the local-dev default baked into
# infra/compose/docker-compose.yml. It only works against that local
# container; use a real password for any shared or hosted database.
POSTGRES_DB=gear
POSTGRES_USER=gear_user
POSTGRES_PASSWORD=gear_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Neo4j ---
# NEO4J_PASSWORD must match NEO4J_AUTH in infra/compose/docker-compose.yml
# (local-dev default shown). A wrong password does not crash the API; graph
# endpoints silently return data_unavailable.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=gear_neo4j_pass

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Optional: give each API+worker pair its own queue when sharing one Redis.
# CELERY_TASK_QUEUE=celery

# --- Auth ---
# Secret used to sign JWTs. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_long_random_string

# --- External APIs ---
# Free key: https://www.eia.gov/opendata/register.php
# Enables live market prices at GET /api/v1/market/prices.
EIA_API_KEY=your_eia_api_key_here

# --- Frontend (apps/web) ---
# Set to HACKATHON_SNAPSHOT to show the snapshot-data badge in the top nav.
# NEXT_PUBLIC_GEAR_DATA_MODE=
